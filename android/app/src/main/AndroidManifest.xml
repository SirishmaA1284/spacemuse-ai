<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.camera" android:required="true" />

    <!-- Optional, not required: the app must stay installable and the
         existing single-photo scan flow must keep working on devices
         without ARCore / Google Play Services for AR (see ArAvailability). -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application
        android:name=".SpaceMuseApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="SpaceMuse AI"
        android:theme="@style/Theme.SpaceMuseAI"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <meta-data android:name="com.google.ar.core" android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SpaceMuseAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>

# ============================================================
# SpaceMuse AI — Environment Configuration
# Copy to .env and fill in real values. Never commit .env.
# All of these are consumed by backend/ only. The Android app
# never embeds these keys — it calls the backend, which holds
# credentials server-side.
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# --- Gemini (Google AI Studio or Vertex AI) ---
# Used for: multimodal room reasoning, design reasoning, image
# understanding/generation, conversational agent, Gemini Live.
GEMINI_API_KEY=
# gemini-2.5-* shuts down Oct 16 2026 on the Developer API — default here is
# the current stable line as of this writing. Verify against
# https://ai.google.dev/gemini-api/docs/models before deploying.
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_LOCATION=us-central1

# --- Product Discovery ---
# At least one provider should be configured for SHOP_FOR_PRODUCT /
# TRY_PRODUCT intents to return real (non-demo) results.
SERPAPI_KEY=
GOOGLE_SHOPPING_API_KEY=
GOOGLE_SHOPPING_CSE_ID=

AMAZON_PA_API_ACCESS_KEY=
AMAZON_PA_API_SECRET_KEY=
AMAZON_PA_API_PARTNER_TAG=
AMAZON_PA_API_REGION=IN

FLIPKART_AFFILIATE_ID=
FLIPKART_AFFILIATE_TOKEN=

# --- Auth ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
JWT_SECRET=

# --- Database ---
# Local dev default: SQLite via Prisma. Swap to Postgres in prod.
DATABASE_URL="file:./dev.db"

# --- Observability (optional) ---
SENTRY_DSN=
LOG_LEVEL=info
